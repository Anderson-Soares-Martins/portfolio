---
// Persistent, site-wide reactive gradient. Pure CSS + a few CSS custom
// properties nudged by pointer/scroll in interactions.ts, deliberately not
// a WebGL shader: it reads as one, costs nothing, and never competes with
// the actual 3D budget spent on the Hero chip.
---

<div class="ambient-field pointer-events-none fixed inset-0 -z-20 overflow-hidden" aria-hidden="true" data-ambient-field>
  <span class="ambient-blob ambient-blob--amber animate-drift"></span>
  <span class="ambient-blob ambient-blob--teal animate-drift-slow"></span>
  <span class="ambient-blob ambient-blob--amber2 animate-drift"></span>
</div>

<style>
  .ambient-blob {
    position: absolute;
    width: 42rem;
    height: 42rem;
    border-radius: 9999px;
    filter: blur(130px);
    will-change: transform;
    transform: translate3d(calc(var(--ax, 0) * 1px), calc(var(--ay, 0) * 1px), 0);
    transition: transform 1.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .ambient-blob--amber {
    top: -14%;
    left: -10%;
    background: var(--color-amber);
    opacity: 0.22;
  }
  .ambient-blob--teal {
    bottom: -18%;
    right: -12%;
    width: 38rem;
    height: 38rem;
    background: var(--color-teal);
    opacity: 0.14;
    transform: translate3d(calc(var(--ax, 0) * -1px), calc(var(--ay, 0) * -1px), 0);
  }
  .ambient-blob--amber2 {
    top: 45%;
    left: 58%;
    width: 30rem;
    height: 30rem;
    background: var(--color-amber);
    opacity: 0.1;
    transform: translate3d(calc(var(--ax, 0) * 0.55px), calc(var(--ay, 0) * 0.55px), 0);
  }

  @media (prefers-reduced-motion: reduce) {
    .ambient-blob {
      transition: none;
    }
  }
</style>
