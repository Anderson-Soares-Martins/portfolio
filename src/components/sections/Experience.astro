---
import SectionHeading from "../SectionHeading.astro";
import { experience } from "../../content/experience";

const locale = (Astro.currentLocale ?? "pt") as "pt" | "en";
const t = experience[locale];
---

<section id="experience" class="scroll-mt-20 py-24 sm:py-32">
  <div class="container-page">
    <SectionHeading eyebrow={t.eyebrow} heading={t.heading} />

    <ol class="mt-14 space-y-12 border-l border-line/70 pl-8 sm:pl-10">
      {
        t.items.map((item) => (
          <li class="reveal relative">
            <span
              class:list={[
                "absolute -left-[calc(2rem+5px)] top-1.5 h-2.5 w-2.5 rounded-full sm:-left-[calc(2.5rem+5px)]",
                item.now ? "bg-amber shadow-glow" : "bg-line"
              ]}
            />
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h3 class="text-xl">
                {item.role} <span class="text-ink-dim">· {item.org}</span>
              </h3>
              <span class="font-mono text-xs text-ink-dim">{item.period}</span>
            </div>
            <ul class="mt-4 space-y-2">
              {item.bullets.map((bullet) => (
                <li class="flex gap-3 text-sm leading-relaxed text-ink-dim">
                  <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-ink-dim" />
                  {bullet}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </div>
</section>
