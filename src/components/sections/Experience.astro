---
import SectionHeading from "../SectionHeading.astro";
import { experience } from "../../content/experience";

const locale = (Astro.currentLocale ?? "pt") as "pt" | "en";
const t = experience[locale];

const items = [...t.items].reverse();
---

<section id="experience" class="scroll-mt-20 py-24 sm:py-32">
  <div class="container-page">
    <SectionHeading index="04" eyebrow={t.eyebrow} heading={t.heading} />

    <ol class="mt-14 border-t border-line/60">
      {
        items.map((item) => (
          <li class="reveal grid gap-x-10 gap-y-2 border-b border-line/60 py-8 sm:grid-cols-[10rem_1fr]">
            <div class="flex items-start gap-2.5 font-mono text-xs">
              {item.now && <span class="mt-1 h-1.5 w-1.5 shrink-0 animate-pulse rounded-full bg-amber" />}
              <span class:list={[item.now ? "text-amber" : "text-ink-dim"]}>{item.period}</span>
            </div>
            <div>
              <h3 class="text-xl">
                {item.role} <span class="text-ink-dim">· {item.org}</span>
              </h3>
              <ul class="mt-4 space-y-2">
                {item.bullets.map((bullet) => (
                  <li class="flex gap-3 text-sm leading-relaxed text-ink-dim">
                    <span class="mt-2.5 h-px w-3 shrink-0 bg-ink-dim/50" />
                    {bullet}
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
