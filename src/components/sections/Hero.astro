---
import { hero } from "../../content/hero";

const locale = (Astro.currentLocale ?? "pt") as "pt" | "en";
const t = hero[locale];
---

<section id="hero" class="relative flex min-h-[92vh] items-center overflow-hidden pt-16 sm:pt-20">
  <div class="hero-grid pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="container-page grid items-center gap-14 py-20 lg:grid-cols-[1.15fr_0.85fr]">
    <div>
      <p class="reveal section-label">{t.eyebrow}</p>

      <a
        href="#experience"
        class="reveal mt-4 inline-flex w-fit items-center gap-2 border border-line px-4 py-1.5 font-mono text-xs text-ink-dim transition-colors duration-200 hover:border-amber hover:text-amber"
      >
        <span class="h-1.5 w-1.5 shrink-0 animate-pulse rounded-full bg-amber"></span>
        {t.currentRole}
      </a>

      <h1 class="reveal mt-6 max-w-3xl text-[2.75rem] leading-[1.05] sm:text-6xl xl:text-[4.5rem]">
        {t.headline.pre}<em class="headline-accent">{t.headline.accent}</em>{t.headline.post}
      </h1>

      <p class="reveal mt-6 max-w-xl text-base leading-relaxed text-ink-dim sm:text-lg">
        {t.subheadline}
      </p>

      <div class="reveal mt-9 flex flex-wrap items-center gap-4">
        <a href="#projects" class="btn btn-primary">{t.ctaPrimary}</a>
        <a href="#contact" class="btn btn-ghost">{t.ctaSecondary}</a>
      </div>
    </div>

    <div class="reveal" data-terminal data-terminal-config={JSON.stringify(t.terminal)}>
      <div class="terminal-frame overflow-hidden rounded-xl border border-line bg-surface/70 backdrop-blur-sm">
        <div class="flex items-center justify-between border-b border-line/70 px-4 py-2.5">
          <span class="font-mono text-[0.65rem] text-ink-dim">{t.terminal.prompt}</span>
          <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-amber" aria-hidden="true"></span>
        </div>
        <div
          class="terminal-output space-y-1 overflow-y-auto px-4 pt-3 font-mono text-[0.75rem] leading-relaxed sm:text-xs"
          data-terminal-output
          aria-live="polite"
        >
        </div>
        <div class="flex items-center gap-2 px-4 pb-3.5 pt-1.5 font-mono text-[0.75rem] sm:text-xs">
          <span class="text-amber">&gt;</span>
          <input
            type="text"
            data-terminal-input
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            placeholder={t.terminal.placeholder}
            class="w-full bg-transparent text-ink outline-none placeholder:text-ink-dim/50"
          />
        </div>
      </div>
      <p class="mt-3 text-right font-mono text-[0.65rem] text-ink-dim/60">{t.terminal.caption}</p>
    </div>
  </div>
</section>

<style>
  .hero-grid {
    background-image: radial-gradient(circle, var(--color-line) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, black, transparent 75%);
    opacity: 0.6;
  }

  .headline-accent {
    font-style: italic;
    font-variation-settings: "SOFT" 60, "WONK" 1, "opsz" 90;
    color: var(--color-amber);
  }

  .terminal-output {
    min-height: 9.5rem;
    max-height: 13rem;
  }
  .terminal-output :global(p) {
    white-space: pre-wrap;
    word-break: break-word;
  }
</style>
