---
import { hero } from "../../content/hero";

const locale = (Astro.currentLocale ?? "pt") as "pt" | "en";
const t = hero[locale];
---

<section id="hero" class="relative flex min-h-[92vh] items-center overflow-hidden pt-16 sm:pt-20">
  <div class="hero-grid pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

  <div class="chip-stage pointer-events-auto absolute right-[3%] top-1/2 hidden h-[24rem] w-[24rem] -translate-y-1/2 lg:block xl:h-[28rem] xl:w-[28rem]">
    <canvas data-webgl-canvas class="h-full w-full"></canvas>
  </div>

  <div class="container-page py-20">
    <p class="reveal section-label">{t.eyebrow}</p>

    <a
      href="#experience"
      class="reveal mt-4 inline-flex w-fit items-center gap-2 rounded-full border border-line px-4 py-1.5 font-mono text-xs text-ink-dim transition-colors duration-200 hover:border-amber hover:text-amber"
    >
      <span class="h-1.5 w-1.5 shrink-0 animate-pulse rounded-full bg-amber"></span>
      {t.currentRole}
    </a>

    <h1 class="reveal mt-6 max-w-3xl text-[2.75rem] leading-[1.05] sm:text-6xl lg:text-[5rem]">
      {t.headline}
    </h1>

    <p class="reveal mt-6 max-w-xl text-base leading-relaxed text-ink-dim sm:text-lg">
      {t.subheadline}
    </p>

    <div class="reveal mt-9 flex flex-wrap items-center gap-4">
      <a href="#projects" class="btn btn-primary">{t.ctaPrimary}</a>
      <a href="#contact" class="btn btn-ghost">{t.ctaSecondary}</a>
    </div>

    <div class="reveal mt-14 max-w-xl" data-terminal data-terminal-config={JSON.stringify(t.terminal)}>
      <div class="terminal-frame overflow-hidden rounded-xl border border-line bg-surface/70 backdrop-blur-sm">
        <div class="flex items-center gap-1.5 border-b border-line/70 px-4 py-2.5">
          <span class="h-2.5 w-2.5 rounded-full bg-ink-dim/25"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-ink-dim/25"></span>
          <span class="h-2.5 w-2.5 rounded-full bg-ink-dim/25"></span>
          <span class="ml-2 font-mono text-[0.65rem] text-ink-dim">{t.terminal.prompt}</span>
        </div>
        <div
          class="terminal-output space-y-1 overflow-y-auto px-4 pt-3 font-mono text-[0.75rem] leading-relaxed sm:text-xs"
          data-terminal-output
          aria-live="polite"
        >
        </div>
        <div class="flex items-center gap-2 px-4 pb-3.5 pt-1.5 font-mono text-[0.75rem] sm:text-xs">
          <span class="text-amber">&gt;</span>
          <input
            type="text"
            data-terminal-input
            autocomplete="off"
            autocapitalize="off"
            spellcheck="false"
            placeholder={t.terminal.placeholder}
            class="w-full bg-transparent text-ink outline-none placeholder:text-ink-dim/50"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const canvas = document.querySelector("[data-webgl-canvas]");
  const stage = canvas?.closest(".chip-stage");

  function bootChip() {
    if (!(canvas instanceof HTMLCanvasElement) || !stage) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (window.innerWidth < 1024) return;
    if (canvas.dataset.sceneBooted === "true") return;
    canvas.dataset.sceneBooted = "true";

    import("../../scripts/scene.ts")
      .then((mod) => mod.initScene(canvas))
      .catch(() => {});
  }

  bootChip();
</script>

<style>
  .hero-grid {
    background-image: radial-gradient(circle, var(--color-line) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, black, transparent 75%);
    opacity: 0.6;
  }

  .chip-stage {
    filter: drop-shadow(0 20px 60px oklch(0.16 0.015 55 / 0.5));
  }

  .terminal-output {
    max-height: 8.5rem;
  }
  .terminal-output :global(p) {
    white-space: pre-wrap;
    word-break: break-word;
  }
</style>
