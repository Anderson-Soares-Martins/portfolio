---
import SectionHeading from "../SectionHeading.astro";
import { contact } from "../../content/contact";
import { site } from "../../content/site";

const locale = (Astro.currentLocale ?? "pt") as "pt" | "en";
const t = contact[locale];
const whatsappHref = `https://wa.me/${site.phone.replace(/\D/g, "")}`;
---

<section id="contact" class="scroll-mt-20 py-24 sm:py-32">
  <div class="container-page grid gap-14 lg:grid-cols-[1.1fr_1fr]">
    <div>
      <SectionHeading eyebrow={t.eyebrow} heading={t.heading} sub={t.sub} />

      <form
        data-contact-form
        data-sending={t.formSending}
        data-success={t.formSuccess}
        data-error={t.formError}
        class="reveal mt-10 max-w-lg space-y-5"
      >
        <div class="space-y-1.5">
          <label for="name" class="font-mono text-xs uppercase tracking-wider text-ink-dim">{t.formName}</label>
          <input
            id="name"
            name="name"
            type="text"
            required
            class="w-full rounded-lg border border-line bg-surface px-4 py-3 text-sm text-ink outline-none transition-colors duration-200 focus:border-amber"
          />
        </div>
        <div class="space-y-1.5">
          <label for="email" class="font-mono text-xs uppercase tracking-wider text-ink-dim">{t.formEmail}</label>
          <input
            id="email"
            name="email"
            type="email"
            required
            class="w-full rounded-lg border border-line bg-surface px-4 py-3 text-sm text-ink outline-none transition-colors duration-200 focus:border-amber"
          />
        </div>
        <div class="space-y-1.5">
          <label for="message" class="font-mono text-xs uppercase tracking-wider text-ink-dim">{t.formMessage}</label>
          <textarea
            id="message"
            name="message"
            rows="4"
            required
            class="w-full resize-none rounded-lg border border-line bg-surface px-4 py-3 text-sm text-ink outline-none transition-colors duration-200 focus:border-amber"
          ></textarea>
        </div>

        <button type="submit" class="btn btn-primary">
          <span data-submit-label>{t.formSubmit}</span>
        </button>

        <p data-form-status role="status" aria-live="polite" class="font-mono text-xs data-[state=success]:text-teal data-[state=error]:text-red-400"></p>
      </form>
    </div>

    <div class="reveal flex flex-col justify-between gap-10 lg:pt-16">
      <div class="space-y-4">
        <p class="font-mono text-xs uppercase tracking-wider text-ink-dim">{t.directLabel}</p>
        <div class="flex flex-col gap-3 text-lg">
          <a href={`mailto:${site.email}`} class="link-underline w-fit">{site.email}</a>
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="link-underline w-fit">
            {site.phoneDisplay}
          </a>
          <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="link-underline w-fit">LinkedIn</a>
          <a href={site.github} target="_blank" rel="noopener noreferrer" class="link-underline w-fit">GitHub</a>
        </div>
      </div>

      <div class="space-y-3 border-t border-line/60 pt-6">
        <p class="font-mono text-xs uppercase tracking-wider text-ink-dim">{t.resumeLabel}</p>
        <div class="flex gap-3">
          <a href={site.resumePt} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">{t.resumePt}</a>
          <a href={site.resumeEn} target="_blank" rel="noopener noreferrer" class="btn btn-ghost">{t.resumeEn}</a>
        </div>
      </div>
    </div>
  </div>
</section>
