---
import SectionHeading from "../SectionHeading.astro";
import { stack } from "../../content/stack";

const locale = (Astro.currentLocale ?? "pt") as "pt" | "en";
const t = stack[locale];
---

<section id="stack" class="scroll-mt-20 py-24 sm:py-32">
  <div class="container-page">
    <SectionHeading eyebrow={t.eyebrow} heading={t.heading} sub={t.sub} />

    <div class="mt-14 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        t.categories.map((cat) => (
          <article class="spotlight reveal flex h-full flex-col p-6">
            <span class="font-mono text-xs text-ink-dim">{cat.index}</span>
            <h3 class="mt-3 text-xl">{cat.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-dim">{cat.description}</p>
            <ul class="mt-5 flex flex-wrap gap-2">
              {cat.items.map((item) => (
                <li class="rounded-full border border-line px-3 py-1 font-mono text-[0.7rem] text-ink-dim">
                  {item}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
