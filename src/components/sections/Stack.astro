---
import GhostNumeral from "../GhostNumeral.astro";
import SectionHeading from "../SectionHeading.astro";
import { stack } from "../../content/stack";

const locale = (Astro.currentLocale ?? "pt") as "pt" | "en";
const t = stack[locale];

// Layout for the interactive graph, index-matched to t.categories.
const positions = [
  { x: 16, y: 24 }, // 01 Frontend & Produto
  { x: 52, y: 12 }, // 02 Backend & Dados
  { x: 14, y: 68 }, // 03 Mobile
  { x: 48, y: 58 }, // 04 Integrações & Automação
  { x: 82, y: 28 }, // 05 Engenharia assistida por IA
  { x: 78, y: 78 } // 06 Hardware & IoT
];
const edges: Array<[number, number]> = [
  [0, 1],
  [0, 2],
  [1, 3],
  [1, 4],
  [3, 4],
  [4, 5],
  [1, 5]
];
---

<section id="stack" class="relative scroll-mt-20 overflow-hidden py-24 sm:py-32">
  <GhostNumeral value="02" class="pointer-events-none absolute -top-6 right-0 hidden text-[10rem] sm:block lg:text-[13rem]" />

  <div class="container-page relative">
    <SectionHeading eyebrow={t.eyebrow} heading={t.heading} sub={t.sub} />

    <div
      class="graph-shell reveal relative mt-14 hidden h-[22rem] rounded-2xl border border-line/60 bg-surface/40 sm:block sm:h-[26rem]"
      data-stack-graph
    >
      <svg class="pointer-events-none absolute inset-0 h-full w-full" data-graph-edges aria-hidden="true">
        {edges.map(([a, b]) => (
          <line data-edge={`${a}-${b}`} x1="0" y1="0" x2="0" y2="0" />
        ))}
      </svg>

      {
        t.categories.map((cat, i) => (
          <button
            type="button"
            class="graph-node"
            data-node={i}
            style={`left:${positions[i].x}%; top:${positions[i].y}%`}
          >
            <span class="block font-mono text-[0.65rem] text-amber">{cat.index}</span>
            <span class="block text-[0.8rem] leading-tight">{cat.title}</span>
          </button>
        ))
      }
    </div>

    <div class="mt-10 divide-y divide-line/60 border-t border-line/60">
      {
        t.categories.map((cat, i) => (
          <article class="legend-row reveal grid gap-x-8 gap-y-3 py-8 sm:grid-cols-[11rem_1fr]" data-legend={i}>
            <div>
              <span class="font-mono text-xs text-ink-dim">{cat.index}</span>
              <h3 class="mt-1 text-xl">{cat.title}</h3>
            </div>
            <div>
              <p class="max-w-xl text-sm leading-relaxed text-ink-dim">{cat.description}</p>
              <ul class="mt-4 flex flex-wrap gap-x-5 gap-y-1.5">
                {cat.items.map((item) => (
                  <li class="tag">{item}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .graph-node {
    position: absolute;
    transform: translate(-50%, -50%);
    touch-action: none;
    cursor: grab;
    max-width: 9.5rem;
    padding: 0.7rem 1rem;
    border-radius: 9999px;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    text-align: center;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, background-color 0.25s ease;
  }
  .graph-node:hover,
  .graph-node[data-active] {
    border-color: var(--color-amber);
    box-shadow: var(--shadow-glow);
  }
  .graph-node:active {
    cursor: grabbing;
  }

  [data-graph-edges] line {
    stroke: var(--color-line);
    stroke-width: 1;
    transition: stroke 0.25s ease, stroke-width 0.25s ease;
  }
  [data-graph-edges] line[data-active] {
    stroke: var(--color-amber);
    stroke-width: 1.6;
  }

  .legend-row {
    border-left: 2px solid transparent;
    padding-left: 1.25rem;
    margin-left: -1.25rem;
    transition: border-color 0.25s ease;
  }
  .legend-row[data-active] {
    border-left-color: var(--color-amber);
  }
  .legend-row[data-active] h3 {
    color: var(--color-amber);
  }
</style>
